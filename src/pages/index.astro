---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const [tableware, knives, kitchen] = await Promise.all([
  getCollection('tableware'),
  getCollection('knives'),
  getCollection('kitchen'),
]);

const categories = [
  {
    label: 'Tableware',
    href: '/tableware',
    description: 'Noritake dinnerware — everyday sets, fine china, and registry picks.',
    count: tableware.filter(a => a.data.status === 'published').length,
  },
  {
    label: 'Knives',
    href: '/knives',
    description: 'Shun, KAI, and competitors — Japanese kitchen knives compared for US buyers.',
    count: knives.filter(a => a.data.status === 'published').length,
  },
  {
    label: 'Kitchen',
    href: '/kitchen',
    description: 'Zojirushi rice cookers, water boilers, and vacuum bottles reviewed.',
    count: kitchen.filter(a => a.data.status === 'published').length,
  },
];

const latest = [
  ...tableware.filter(a => a.data.status === 'published').map(a => ({ ...a, _cat: 'Tableware', _href: `/tableware/${a.slug}` })),
  ...knives.filter(a => a.data.status === 'published').map(a => ({ ...a, _cat: 'Knives',    _href: `/knives/${a.slug}` })),
  ...kitchen.filter(a => a.data.status === 'published').map(a => ({ ...a, _cat: 'Kitchen',  _href: `/kitchen/${a.slug}` })),
]
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 6);
---
<BaseLayout
  title="Japan's Best-Reviewed Products, Re-Verified for Buyers Outside Japan"
  description="The Japan Filter finds products trusted in Japan and re-evaluates them for buyers overseas."
>
  <section class="mx-auto max-w-3xl px-5 py-20 text-center">
    <p class="font-data text-[10px] uppercase tracking-wide2 text-indigo/60 mb-3">The Japan Filter</p>
    <h1 class="font-display text-4xl md:text-5xl text-indigo mb-6 leading-tight">
      Japan's best-reviewed products,<br class="hidden md:block" /> re-verified for buyers outside Japan.
    </h1>
    <p class="font-body text-base text-ink/60 max-w-xl mx-auto mb-12">
      We don't just translate what's popular in Japan — we re-check it against what
      you can actually buy, and trust, from outside the country.
    </p>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3 text-left">
      {categories.map(cat => (
        <a href={cat.href} class="group block border border-line bg-paper p-6 transition-colors hover:border-seal/50 hover:bg-seal/[0.02]">
          <p class="font-data text-[9px] uppercase tracking-wide2 text-indigo/50 mb-2">{cat.count} guides</p>
          <h2 class="font-display text-xl text-indigo mb-2 group-hover:text-indigo-light">{cat.label}</h2>
          <p class="font-body text-sm text-ink/60 leading-relaxed">{cat.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-20 text-left">
    <div class="mb-5 flex items-center justify-between">
      <h2 class="font-data text-[11px] uppercase tracking-wide2 text-ink/50">Latest Guides</h2>
    </div>

    <div class="divide-y divide-line border-y border-line">
      {latest.map(a => (
        <a href={a._href} class="flex items-baseline justify-between gap-6 py-4 hover:bg-indigo/[0.02]">
          <div class="min-w-0">
            <p class="font-body text-[15px] font-medium text-ink leading-snug mb-0.5">{a.data.title}</p>
            <p class="font-body text-sm text-ink/55 leading-relaxed">{a.data.description}</p>
          </div>
          <span class="shrink-0 font-data text-[9px] uppercase tracking-wide2 text-indigo/50">{a._cat}</span>
        </a>
      ))}
    </div>

    <div class="mt-6 flex flex-wrap gap-4">
      {categories.map(cat => (
        <a href={cat.href} class="font-data text-[10px] uppercase tracking-wide2 text-ink/50 transition-colors hover:text-indigo">
          All {cat.label} →
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
