---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About" description="About The Japan Filter">
  <section class="mx-auto max-w-2xl px-5 py-14">
    <h1 class="font-display text-3xl text-indigo mb-6">About The Japan Filter</h1>
    <p class="font-body text-[15px] leading-relaxed text-ink/80 mb-4">
      The Japan Filter re-evaluates products trusted in Japan for buyers outside
      the country. We don't just translate what's popular at home — we check
      whether it's actually available, authentic, and worth buying from abroad.
    </p>
    <p class="font-body text-[15px] leading-relaxed text-ink/80">
      Every guide includes a "How We Researched This Guide" section describing
      the sources we checked and how we verified each product.
    </p>
  </section>
</BaseLayout>
