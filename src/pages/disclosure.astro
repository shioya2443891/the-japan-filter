---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Affiliate Disclosure" description="Affiliate Disclosure for The Japan Filter">
  <section class="mx-auto max-w-2xl px-5 py-14">
    <h1 class="font-display text-3xl text-indigo mb-6">Affiliate Disclosure</h1>
    <p class="font-body text-[15px] leading-relaxed text-ink/80 mb-6">
      The Japan Filter is a participant in the Amazon Services LLC Associates
      Program, an affiliate advertising program designed to provide a means
      for sites to earn advertising fees by advertising and linking to
      Amazon.com. As an Amazon Associate, we earn from qualifying purchases.
      This does not affect the price you pay.
    </p>
    <p class="font-body text-[15px] leading-relaxed text-ink/80">
      Questions about this disclosure or anything else on the site:
      <a href="mailto:hello@thejapanfilter.com" class="text-indigo underline hover:text-indigo/70">hello@thejapanfilter.com</a>
    </p>
  </section>
</BaseLayout>
