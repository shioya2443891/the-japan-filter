---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('kitchen')).filter(a => a.data.status === 'published');
---
<BaseLayout
  title="Japanese Kitchen Appliances Guides"
  description="Zojirushi rice cookers, water boilers, and more — reviewed for US buyers with Japan market context."
>
  <section class="mx-auto max-w-3xl px-5 py-14">
    <p class="font-data text-[10px] uppercase tracking-wide2 text-indigo/60 mb-2">Category</p>
    <h1 class="font-display text-3xl text-indigo mb-4">Japanese Kitchen Appliances</h1>
    <p class="font-body text-[15px] text-ink/60 mb-10">Zojirushi rice cookers, water boilers, and vacuum bottles — reviewed with domestic Japan market context for US buyers.</p>

    <div class="divide-y divide-line border-y border-line">
      {articles.map((a) => (
        <a href={`/kitchen/${a.slug}`} class="block py-5 hover:bg-indigo/[0.02]">
          <h2 class="font-body text-base font-medium text-ink mb-1">{a.data.title}</h2>
          <p class="font-body text-sm text-ink/60">{a.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
