---
// FinalVerdict.astro
// 記事の最終判定。否定的な結論も堂々と出せる設計にする。
// rating に応じてカラーを変え、判定の重みを視覚的に伝える。

interface Props {
  rating: 'recommended' | 'conditional' | 'not-recommended';
  summary: string;
  bestPickName?: string | null;
  bestPickUrl?: string | null;
  bestPickBrand?: string | null;
}
const { rating, summary, bestPickName, bestPickUrl, bestPickBrand } = Astro.props;

const isRecommended   = rating === 'recommended';
const isConditional   = rating === 'conditional';
const isNotRecommended = rating === 'not-recommended';

const icon  = isRecommended ? '✓' : isConditional ? '◆' : '✕';
const label = isRecommended
  ? 'Recommended'
  : isConditional
  ? 'Conditional'
  : 'Not Recommended for US Buyers';
---

<section
  class:list={[
    'my-12 overflow-hidden border bg-paper',
    isRecommended   && 'border-indigo',
    isConditional   && 'border-line',
    isNotRecommended && 'border-seal',
  ]}
>

  <!-- ヘッダー: rating ごとに色が変わる帯 -->
  <div
    class:list={[
      'flex items-center gap-4 px-5 py-4',
      isRecommended   && 'bg-indigo',
      isConditional   && 'bg-ink/[0.06]',
      isNotRecommended && 'bg-seal',
    ]}
  >
    <!-- アイコン -->
    <span
      class:list={[
        'font-data text-2xl leading-none',
        (isRecommended || isNotRecommended) && 'text-paper',
        isConditional && 'text-ink/70',
      ]}
      aria-hidden="true"
    >
      {icon}
    </span>

    <!-- ラベル -->
    <div>
      <p
        class:list={[
          'font-data text-[9px] uppercase tracking-wide2',
          (isRecommended || isNotRecommended) && 'text-paper/55',
          isConditional && 'text-ink/40',
        ]}
      >
        Final Verdict
      </p>
      <p
        class:list={[
          'font-data text-[13px] uppercase tracking-wide2',
          (isRecommended || isNotRecommended) && 'text-paper',
          isConditional && 'text-ink',
        ]}
      >
        {label}
      </p>
    </div>
  </div>

  <!-- 要約 -->
  <div class="px-5 py-6">
    <p class="font-body text-[15px] leading-relaxed text-ink/85">{summary}</p>

    <!-- Best Pick: bestPickName が設定されている場合のみ表示 -->
    {bestPickName && (
      <div class="mt-5 border-t border-line pt-4">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="flex flex-wrap items-center gap-3">
            <span class="font-data text-[10px] uppercase tracking-wide2 text-ink/40">Best Pick</span>
            <span
              class:list={[
                'font-body text-sm font-medium',
                isRecommended   && 'text-indigo',
                isConditional   && 'text-ink',
                isNotRecommended && 'text-seal',
              ]}
            >
              {bestPickName}
            </span>
          </div>

          {bestPickUrl && (
            <div class="flex flex-col items-end gap-1">
              <a
                href={bestPickUrl}
                rel="nofollow sponsored noopener"
                target="_blank"
                data-affiliate-product={bestPickName || ''}
                data-affiliate-brand={bestPickBrand || ''}
                class="whitespace-nowrap border border-seal px-4 py-2 font-data text-[11px] uppercase tracking-wide2 text-seal transition-colors hover:bg-seal hover:text-paper"
              >
                Check on Amazon →
              </a>
              <span class="font-body text-[10px] italic text-ink/40">(paid link)</span>
            </div>
          )}
        </div>
      </div>
    )}
  </div>

</section>
