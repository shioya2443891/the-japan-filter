---
// VerifiedBadge.astro
// ブランドの署名要素。"Best Overall" 等の認定を、鑑定印（hanko）を思わせる
// 円形パーフォレーション（検品タグの縁取り）で表現する。
interface Props {
  label: string; // 例: "Best Overall" / "Best for Beginners" / "Best Value"
  rotate?: number; // 手作業の検品タグらしい微妙な傾き（度数）
}
const { label, rotate = -4 } = Astro.props;
---

<div
  class="relative inline-flex h-20 w-20 shrink-0 items-center justify-center"
  style={`transform: rotate(${rotate}deg);`}
  aria-hidden="false"
  role="img"
  aria-label={`${label} — verified by The Japan Filter`}
>
  <svg viewBox="0 0 100 100" class="absolute inset-0 h-full w-full">
    <circle
      cx="50" cy="50" r="46"
      fill="none"
      stroke="#B33A3A"
      stroke-width="1.5"
      stroke-dasharray="2.6 3.2"
    />
    <circle cx="50" cy="50" r="38" fill="none" stroke="#B33A3A" stroke-width="1" />
  </svg>
  <span
    class="relative z-10 px-2 text-center font-display text-[11px] font-medium uppercase leading-tight tracking-wide2 text-seal"
  >
    {label}
  </span>
</div>
