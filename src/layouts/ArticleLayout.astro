---
import BaseLayout from './BaseLayout.astro';
import HowWeResearched from '../components/HowWeResearched.astro';

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  researchSteps: { label: string; detail: string }[];
  sourcesChecked: string[];
  lastVerified: string;
}
const { title, description, publishDate, researchSteps, sourcesChecked, lastVerified } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-3xl px-5 py-14">
    <p class="font-data text-[10px] uppercase tracking-wide2 text-indigo/60 mb-2">Tableware</p>
    <h1 class="font-display text-3xl md:text-4xl text-indigo mb-3">{title}</h1>
    <p class="font-body text-sm text-ink/50 mb-8">
      Published {publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
    </p>

    <div class="prose-content font-body text-[15px] leading-relaxed text-ink/85">
      <slot />
    </div>

    <HowWeResearched steps={researchSteps} sourcesChecked={sourcesChecked} lastVerified={lastVerified} />
  </article>
</BaseLayout>
