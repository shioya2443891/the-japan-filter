---
import BaseLayout from './BaseLayout.astro';
import HowWeResearched from '../components/HowWeResearched.astro';
import ProductCard from '../components/ProductCard.astro';

interface Spec { label: string; value: string; }
interface Origin { brandCountry: string; madeIn: string | null; officialSeller: string | null; }
interface Ratings { stars: number | null; reviewCount: number | null; badge: string | null; verifiedAt: string; }
interface AmazonData { url: string; asin: string | null; affiliateTag: string | null; imageUrl: string | null; }
interface Product {
  id: string;
  award: string | null;
  name: string;
  priceTier: '$' | '$$' | '$$$';
  priceNote: string | null;
  setContents: string;
  specs: Spec[];
  origin: Origin;
  usNotes: string[];
  whyPicked: string[];
  ratings: Ratings;
  amazon: AmazonData;
  ctaLabel: string;
}

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  researchSteps: { label: string; detail: string }[];
  sourcesChecked: string[];
  lastVerified: string;
  ogImage?: string;
  intro?: string;
  products?: Product[];
}
const {
  title, description, publishDate, researchSteps, sourcesChecked, lastVerified,
  ogImage, intro, products,
} = Astro.props;

const hasProducts = products && products.length > 0;
---
<BaseLayout title={title} description={description} ogImage={ogImage}>
  <article class="mx-auto max-w-3xl px-5 py-14">

    <!-- 記事ヘッダー -->
    <p class="mb-2 font-data text-[10px] uppercase tracking-wide2 text-indigo/60">Tableware</p>
    <h1 class="mb-3 font-display text-3xl text-indigo md:text-4xl">{title}</h1>
    <p class="mb-8 font-body text-sm text-ink/50">
      Published {publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
    </p>

    <!-- イントロ: frontmatter の intro フィールドがある場合に商品カードの前に表示 -->
    {intro && (
      <div class="mb-10 font-body text-[15px] leading-relaxed text-ink/80">
        <p>{intro}</p>
      </div>
    )}

    <!-- 商品カード: products 配列がある記事のみ表示 -->
    {hasProducts && (
      <section aria-label="Product picks">
        {products.map(p => <ProductCard product={p} />)}
      </section>
    )}

    <!-- 記事本文 (編集・解説セクション) -->
    <div class="prose-content font-body text-[15px] leading-relaxed text-ink/85">
      <slot />
    </div>

    <HowWeResearched steps={researchSteps} sourcesChecked={sourcesChecked} lastVerified={lastVerified} />
  </article>
</BaseLayout>
