---
interface Props {
  title: string;
  description: string;
  ogImage?: string;
}
const { title, description, ogImage } = Astro.props;
const siteUrl = Astro.site?.href ?? 'https://thejapanfilter.com/';
const ogImageUrl = new URL(ogImage ?? '/og/og-default.png', siteUrl).toString();
const fullTitle = `${title} | The Japan Filter`;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImageUrl} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body class="bg-paper font-body text-ink">

  <!-- Header -->
  <header>
    <!-- 検品ラインを思わせる朱色のヘアライン -->
    <div class="h-0.5 bg-seal"></div>

    <div class="border-b border-line">
      <div class="mx-auto flex max-w-4xl items-center gap-6 px-5 py-5">

        <!-- ブランド + タグライン -->
        <div class="min-w-0 flex-1">
          <a href="/" class="block font-display text-xl leading-none text-indigo transition-colors hover:text-indigo-light">
            The Japan Filter
          </a>
          <p class="mt-1.5 font-data text-[10px] leading-snug tracking-wide2 text-ink/45">
            Japan's best-reviewed products, re-verified for buyers outside Japan.
          </p>
        </div>

        <!-- ナビゲーション -->
        <nav class="flex shrink-0 items-center gap-5 font-data text-[11px] uppercase tracking-wide2 text-ink/60">
          <a href="/tableware" class="transition-colors hover:text-indigo">Tableware</a>
          <a href="/about" class="transition-colors hover:text-indigo">About</a>
        </nav>

      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="mt-20 border-t border-line">

    <!-- 3カラム本体 -->
    <div class="mx-auto max-w-4xl px-5 py-12">
      <div class="grid grid-cols-1 gap-10 sm:grid-cols-3">

        <!-- Col 1: ブランド + ミッション -->
        <div>
          <p class="mb-3 border-l-2 border-seal pl-2.5 font-data text-[10px] uppercase tracking-wide2 text-ink/40">
            The Japan Filter
          </p>
          <p class="font-display text-base text-indigo">Independent reviews,<br />verified from Japan.</p>
          <p class="mt-2 font-body text-[13px] leading-relaxed text-ink/55">
            We research and verify Japanese products using domestic market information
            and manufacturer sources, then translate that context for buyers outside Japan.
          </p>
        </div>

        <!-- Col 2: カテゴリー -->
        <div>
          <p class="mb-3 border-l-2 border-seal pl-2.5 font-data text-[10px] uppercase tracking-wide2 text-ink/40">
            Categories
          </p>
          <ul class="space-y-2.5">
            <li>
              <a href="/tableware" class="font-body text-sm text-ink/70 transition-colors hover:text-indigo">
                Tableware
              </a>
            </li>
          </ul>
        </div>

        <!-- Col 3: サイトリンク -->
        <div>
          <p class="mb-3 border-l-2 border-seal pl-2.5 font-data text-[10px] uppercase tracking-wide2 text-ink/40">
            Site
          </p>
          <ul class="space-y-2.5">
            <li>
              <a href="/about" class="font-body text-sm text-ink/70 transition-colors hover:text-indigo">
                About
              </a>
            </li>
            <li>
              <a href="/privacy-policy" class="font-body text-sm text-ink/70 transition-colors hover:text-indigo">
                Privacy Policy
              </a>
            </li>
            <li>
              <a href="/disclosure" class="font-body text-sm text-ink/70 transition-colors hover:text-indigo">
                Affiliate Disclosure
              </a>
            </li>
          </ul>
        </div>

      </div>
    </div>

    <!-- ボトムバー: Amazon開示 + 著作権 -->
    <div class="border-t border-line">
      <div class="mx-auto flex max-w-4xl flex-col gap-1 px-5 py-5 sm:flex-row sm:items-center sm:justify-between">
        <p class="font-data text-[10px] text-ink/40">
          As an Amazon Associate, The Japan Filter earns from qualifying purchases.
        </p>
        <p class="font-data text-[10px] text-ink/35">
          © {year} The Japan Filter. All rights reserved.
        </p>
      </div>
    </div>

  </footer>

</body>
</html>
